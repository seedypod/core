{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "type": "docs", "scope": "README", "release": "patch" },
          { "type": "test", "release": "patch" },
          { "type": "style", "release": "patch" },
          { "type": "perf", "release": "patch" },
          { "type": "ci", "release": "patch" },
          { "type": "build", "release": "patch" },
          { "type": "chore", "release": "patch" },
          { "type": "deploy", "release": "minor" },
          { "type": "refactor", "release": "patch" }
        ]
      }
    ],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "seedypod-core.tar.gz", "label": "seedypod-core (source + built web/server)" },
          { "path": "seedypod-core.tar.gz.sha256", "label": "seedypod-core sha256" },
          { "path": "release-assets/hald-arm-unknown-linux-gnueabihf", "label": "hald (Pi Zero W, armv6)" },
          { "path": "release-assets/hald-arm-unknown-linux-gnueabihf.sha256", "label": "hald (Pi Zero W, armv6) sha256" },
          { "path": "release-assets/hald-aarch64-unknown-linux-gnu", "label": "hald (Pi Zero 2 W / Pi 4 / Pi 5, aarch64)" },
          { "path": "release-assets/hald-aarch64-unknown-linux-gnu.sha256", "label": "hald (Pi Zero 2 W / Pi 4 / Pi 5, aarch64) sha256" },
          { "path": "release-assets/podvision-arm-unknown-linux-gnueabihf", "label": "podvision (Pi Zero W, armv6)" },
          { "path": "release-assets/podvision-arm-unknown-linux-gnueabihf.sha256", "label": "podvision (Pi Zero W, armv6) sha256" },
          { "path": "release-assets/podvision-aarch64-unknown-linux-gnu", "label": "podvision (Pi Zero 2 W / Pi 4 / Pi 5, aarch64)" },
          { "path": "release-assets/podvision-aarch64-unknown-linux-gnu.sha256", "label": "podvision (Pi Zero 2 W / Pi 4 / Pi 5, aarch64) sha256" },
          { "path": "release-assets/better-sqlite3-*.tar.gz", "label": "better-sqlite3 (Pi Zero W, armv6)" },
          { "path": "release-assets/better-sqlite3-*.tar.gz.sha256", "label": "better-sqlite3 (Pi Zero W, armv6) sha256" }
        ]
      }
    ]
  ]
}
