# seedypod core — copy to .env (or set in the systemd unit). All optional.

# Where state lives (SQLite + captures). Default ./data
DATA_DIR=./data
# DATABASE_URL=./data/seedypod.db

# Hardware daemon. Unset ⇒ in-process simulator (dev/CI).
# HAL_MQTT_URL=mqtt://127.0.0.1:1883
# HAL_UNIT_ID=gardyn-1a2b3c4d          # printed by `hald --check`
# HAL_HTTP_URL=http://127.0.0.1:3001   # hald's stills/health server
# HAL_MQTT_USERNAME=
# HAL_MQTT_PASSWORD=

# Simulator speed (sim only)
# SIM_TIME_SCALE=60

PORT=3000
HOST=0.0.0.0
