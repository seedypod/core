{
  "name": "@seedypod/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "seedypod core — local, cloud-free control for Gardyn hydroponic towers: Hono + tRPC + MCP server, React web UI, and the Rust hardware daemon (hal/)",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "esbuild server/index.ts src/vision/visionWorker.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outdir=server/dist --entry-names=[name]",
    "start": "node server/dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "tsc": "tsc --noEmit",
    "test": "vitest",
    "test:mutation": "stryker run",
    "test:mutation:incremental": "stryker run --incremental",
    "test:browser": "node tests/browser/run.mjs",
    "test:sim-bringup": "node tests/sim/bringup.mjs",
    "hal:build": "cargo build --manifest-path hal/Cargo.toml",
    "hal:test": "cargo test --manifest-path hal/Cargo.toml",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.css": "eslint --fix",
    "*.json": "eslint --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@hono/node-server": "^1.15.0",
    "@hono/node-ws": "^1.3.1",
    "@hono/trpc-server": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.130.0",
    "@trpc/client": "^11.10.0",
    "@trpc/react-query": "^11.10.0",
    "@trpc/server": "^11.10.0",
    "better-sqlite3": "^12.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^4.9.0",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.9.0",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^1.0.0",
    "mqtt": "^5.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "superjson": "^2.2.0",
    "tailwind-merge": "^3.3.0",
    "trpc-to-openapi": "^3.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-plugin": "^1.130.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "aedes": "^1.2.0",
    "concurrently": "^9.2.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "jsdom": "^29.0.0",
    "lint-staged": "^16.4.0",
    "semantic-release": "^25.0.9",
    "shadcn": "^3.0.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  }
}
