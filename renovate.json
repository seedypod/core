{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:monorepos"
  ],
  "automerge": true,
  "automergeType": "branch",
  "minimumReleaseAge": "3 days",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "commitMessagePrefix": "chore",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true,
      "labels": [
        "dependencies",
        "non-major"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "manual"
      ]
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchPackageNames": [
        "@types/*",
        "eslint",
        "typescript"
      ],
      "automerge": true,
      "labels": [
        "devDependencies",
        "auto-merge"
      ]
    },
    {
      "matchPackageNames": [
        "vitest"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "labels": [
        "dependencies",
        "vitest"
      ]
    },
    {
      "matchPackageNames": [
        "next",
        "react",
        "react-dom"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "nextjs",
        "react",
        "manual"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "commitMessagePrefix": "feat(deps-major):",
      "commitMessageAction": "Update {{packageName}}",
      "labels": [
        "dependencies",
        "major"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "commitMessagePrefix": "fix(deps-patch):",
      "commitMessageAction": "Update {{packageName}}",
      "labels": [
        "dependencies",
        "fix-patch"
      ]
    },
    {
      "matchPackagePatterns": [
        ".*"
      ],
      "commitMessagePrefix": "chore(deps):",
      "commitMessageAction": "Update {{packageName}}"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "all cargo non-major",
      "automerge": true,
      "labels": [
        "dependencies",
        "rust"
      ]
    },
    {
      "matchPackageNames": [
        "rppal",
        "rumqttc",
        "tokio",
        "axum"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "rust",
        "manual"
      ]
    }
  ]
}
