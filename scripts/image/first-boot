#!/usr/bin/env bash
# What the seedypod OS image can only do on the unit it boots on, ahead of hald and
# core (seedypod-first-boot.service). The functions are the installers' own, from
# root-owned copies. It turns itself off once it has a unit id, and runs again next
# boot if it doesn't.
set -uo pipefail

ROOT="${SEEDYPOD_ROOT:-}"
LIB="${SEEDYPOD_IMAGE_LIB:-$ROOT/usr/local/lib/seedypod}"
export SUDO=

SEEDYPOD_LIB_ONLY=1 . "$LIB/install"
SEEDYPOD_LIB_ONLY=1 . "$LIB/install-hal"
set +e

id="$(hal_unit_id)"
if [ -z "$id" ]; then echo "hald gave no unit id; trying again next boot" >&2; exit 1; fi
sed "s/__UNIT_ID__/$id/" "$CORE_UNIT" > "$CORE_UNIT.new" && mv -f "$CORE_UNIT.new" "$CORE_UNIT"
systemctl daemon-reload
echo "→ unit id $id"
# So the setup hotspot can come up on a card that was never given a country or a network.
rfkill unblock wifi
apply_wear_settings
systemctl disable seedypod-first-boot.service
