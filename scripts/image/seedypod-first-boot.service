[Unit]
Description=seedypod: finish this unit on its first boot
Before=hald.service seedypod-core.service
After=swap.target
ConditionFileNotEmpty=!/var/lib/seedypod-image/unit.env

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=5min
ExecStart=/usr/local/sbin/seedypod-first-boot

[Install]
WantedBy=multi-user.target
