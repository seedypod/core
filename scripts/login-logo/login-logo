#!/usr/bin/env bash
# seedypod login logo: the animation an SSH login opens with, printed from the
# frames that generate.mjs pre-rendered. Run by /etc/profile.d/seedypod-logo.sh,
# which holds the guards that need the login shell. Bash and stty only; each
# frame is one printf, so a Pi Zero W stays out of the way.
#   truecolor, fits   animation, then the logo
#   256 colours       the logo, no animation
#   anything else     one line of text
# Then the unit's live facts from login-stats, beside the logo or under the line.
# Off with ~/.hushlogin or SEEDYPOD_NO_LOGO=1. Errors stay silent: this must never
# get in the way of a login.
exec 2>/dev/null

[ -t 0 ] && [ -t 1 ] || exit 0
[ "${SEEDYPOD_NO_LOGO:-}" = 1 ] && exit 0
[ -e "${HOME:-}/.hushlogin" ] && exit 0
# su - and sudo -i are logins too, but not new ones: the session's owner has
# already seen it. su keeps a terminal this user doesn't own; sudo may open its own.
[ -O /dev/stdin ] && [ -z "${SUDO_USER:-}" ] || exit 0

dir="${BASH_SOURCE[0]%/*}"
frames="$dir/logo.frames"
read -r version < "$dir/version"
url="http://${HOSTNAME%%.*}.local"
[ -e "$dir/port80.nft" ] || url="$url:3000"

# The live facts beside the logo. login-stats gathers them while the logo
# animates; whatever it hasn't said a second (SEEDYPOD_STATS_MS) after starting
# is left out.
stats=()
stats_pid=""
now() { now=${EPOCHREALTIME//[.,]/}; }
if [ -x "$dir/login-stats" ] && now && [ -n "$now" ]; then
  wait_ms=${SEEDYPOD_STATS_MS:-1000}
  [[ $wait_ms =~ ^[0-9]{1,6}$ ]] || wait_ms=1000
  stats_by=$((now + wait_ms * 1000))
  # Not on the terminal: a straggler mustn't hold it open after the logo exits.
  exec 4< <("$dir/login-stats" </dev/null)
  stats_pid=$!
fi
gather() {
  local left t line
  [ -n "$stats_pid" ] || return 0
  # Past the deadline, still take what's already in the pipe.
  while now; left=$((stats_by - now)); [ "$left" -gt 1000 ] || left=1000; [ "${#stats[@]}" -lt 30 ]; do
    printf -v t '%d.%06d' $((left / 1000000)) $((left % 1000000))
    IFS= read -r -t "$t" -u 4 line || break
    # What core runs beats the version file, which only scripts/install writes.
    case "$line" in version$'\t'*) version=${line#*:} ;; *) stats+=("$line") ;; esac
  done
  kill "$stats_pid"
  stats_pid=""
  exec 4<&-
}

# Sets $facts to one line per fact, the labels in a column, cut to $1 columns;
# coloured when $2 is 1. Each fact is login-stats' label TAB state:text...; a
# first segment bar-<state>:<percent> is drawn as a bar, the text after it beside.
facts=()
fact_lines() {
  local width=$1 colour=$2 fact label seg state text line used need sep=', ' full='#' empty='-'
  local i c cells filled shade pen glued next
  local -a segs shades
  local -A tint=([ok]=114 [warn]=221 [bad]=203 [dim]=245)
  # Four shades a state, darkest first, as on sleepypod's welcome screen.
  local -A ramp=([ok]='29 35 78 114' [warn]='172 214 220 222' [bad]='167 203 209 216')
  [ "$width" -gt 12 ] || return 0
  case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) sep=' · ' full='█' empty='░' ;; esac
  for fact in "${stats[@]}"; do
    IFS=$'\t' read -r -a segs <<< "$fact"
    [ "${#segs[@]}" -gt 1 ] || continue
    printf -v label '%-8s' "${segs[0]:0:7}"
    line="" used=8 glued=""
    [ "$colour" = 1 ] && line=$'\e[38;5;72m'
    line+=$label
    [ "$colour" = 1 ] && line+=$'\e[0m'
    for ((i = 1; i < ${#segs[@]}; i++)); do
      seg=${segs[i]}
      state=${seg%%:*} text=${seg#*:}
      if [[ $state == bar-* ]]; then
        # Ten cells, fewer when the text after it needs the room, and none under four.
        [ "$used" -eq 8 ] && [[ $text =~ ^[0-9]{1,3}$ ]] || continue
        next=${segs[i + 1]:-} next=${next#*:}
        cells=$((width - used - 3 - ${#next}))
        [ "$cells" -le 10 ] || cells=10
        [ "$cells" -ge 4 ] || continue
        filled=$(((text * cells + 50) / 100))
        [ "$filled" -le "$cells" ] || filled=$cells
        read -r -a shades <<< "${ramp[${state#bar-}]:-${ramp[ok]}}"
        line+='[' pen=""
        for ((c = 0; c < cells; c++)); do
          if [ "$colour" = 1 ]; then
            if [ "$c" -lt "$filled" ]; then shade=${shades[filled > 1 ? c * 3 / (filled - 1) : 0]}; else shade=240; fi
            [ "$shade" = "$pen" ] || line+=$'\e[38;5;'"${shade}m" pen=$shade
          fi
          if [ "$c" -lt "$filled" ]; then line+="$full"; else line+="$empty"; fi
        done
        [ -n "$pen" ] && line+=$'\e[0m'
        line+='] '
        used=$((used + cells + 3)) glued=1
        continue
      fi
      need=${#text}
      [ "$used" -gt 8 ] && [ -z "$glued" ] && need=$((need + ${#sep}))
      if [ $((used + need)) -gt "$width" ]; then
        [ "$used" -gt 8 ] && break
        text="${text:0:$((width - used - 2))}.." need=$((width - used))
      fi
      if [ "$used" -gt 8 ] && [ -z "$glued" ]; then
        if [ "$colour" = 1 ]; then line+=$'\e[38;5;245m'"$sep"$'\e[0m'; else line+=$sep; fi
      fi
      if [ "$colour" = 1 ] && [ -n "${tint[$state]:-}" ]; then
        line+=$'\e[38;5;'"${tint[$state]}m$text"$'\e[0m'
      else
        line+=$text
      fi
      used=$((used + need)) glued=""
    done
    facts+=("$line")
  done
}

plain() {
  gather
  printf 'seedypod%s  %s\n' "${version:+ $version}" "$url"
  [ "${term_cols:-0}" -gt 0 ] || term_cols=80
  fact_lines "$term_cols" 0
  [ "${#facts[@]}" -eq 0 ] || printf '%s\n' "${facts[@]}"
  exit 0
}

read -r term_rows term_cols <<< "$(stty size)"
read -r rows text_col text_row delay < "$frames" || plain
[ "${term_rows:-0}" -ge $((rows + 2)) ] && [ "${term_cols:-0}" -gt $((text_col + ${#url})) ] || plain
# A blank line above and below the logo, where the terminal has room for them.
pad=""
[ "${term_rows:-0}" -lt $((rows + 4)) ] || pad='\n'
[ -z "${NO_COLOR:-}" ] || plain
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) ;; *) plain ;; esac

# SSH passes TERM and little else: Debian's sshd accepts COLORTERM but a stock
# client doesn't send it, so most truecolor terminals arrive as xterm-256color.
# Those get the still logo: the terminal isn't asked. A query it doesn't know
# (DECRQSS, say) is printed as text by some, macOS Terminal among them.
depth=0
case "${TERM:-}" in
  ""|dumb|unknown) plain ;;
  *-direct|*-truecolor|xterm-kitty|xterm-ghostty|alacritty*|foot*|wezterm) depth=24 ;;
  *256color*) depth=256 ;;
esac
case "${COLORTERM:-}" in truecolor|24bit) depth=24 ;; esac
[ "${LC_TERMINAL:-}" = iTerm2 ] && depth=24
[ "$depth" = 0 ] && plain

saved="$(stty -g)" || plain
skip=""
cursor_home=""
restore() {
  [ -n "$cursor_home" ] && printf "\\e[%dB\\r$pad" "$rows"
  [ -n "$stats_pid" ] && kill "$stats_pid"
  printf '\e[0m\e[?25h'
  stty "$saved"
}
trap restore EXIT
trap 'skip=1' INT
trap 'exit 0' HUP TERM
# -isig makes Ctrl-C a key like any other. As a signal it would also reach the
# login shell, which then abandons /etc/profile and the user's dotfiles with it.
stty -echo -icanon -isig min 1 time 0
printf '\e[?25l'

mapfile -t lines < "$frames"
[ "${#lines[@]}" -gt 3 ] || exit 0

# Scroll now, so that the frames can move around without ever scrolling.
printf "\r$pad"
for ((i = 0; i < rows; i++)); do printf '\n'; done
printf '\e[%dA' "$rows"
cursor_home=1

if [ "$depth" = 24 ]; then
  for ((i = 3; i < ${#lines[@]}; i++)); do
    printf '%s' "${lines[i]}"
    key=""
    IFS= read -r -t "$delay" key && break
    [ -n "$key$skip" ] && break
  done
  printf '%s' "${lines[1]}"
else
  printf '%s' "${lines[2]}"
fi

gather
printf '\e[%dB' $((text_row + 1))
[ -n "$version" ] && printf '\r\e[%dC\e[38;5;245m%s' "$text_col" "$version"
printf '\n\r\e[%dC\e[38;5;72m%s\e[0m' "$text_col" "$url"

# The facts go under the address, a blank line down, and carry on past the
# bottom of the logo if there are more of them than rows beside it.
fact_lines $((term_cols - text_col - 1)) 1
row=$((text_row + 2))
if [ "${#facts[@]}" -gt 0 ]; then
  printf '\n'
  for fact in "${facts[@]}"; do printf '\n\r\e[%dC%s' "$text_col" "$fact"; done
  row=$((row + 1 + ${#facts[@]}))
fi
if [ "$row" -lt "$rows" ]; then
  printf '\r\e[%dA' "$row"
else
  printf "\\n\\r$pad"
  cursor_home=""
fi
