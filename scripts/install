#!/usr/bin/env bash
# seedypod core installer for a Raspberry Pi running Raspberry Pi OS (64-bit),
# or any 64-bit Linux box on the LAN.
# Usage: curl -fsSL https://raw.githubusercontent.com/seedypod/core/main/scripts/install | bash
#        scripts/install [--branch dev] [--prefix /opt/seedypod] [--restore <file|url>] [--check] [--login-logo]
#                        [--port80 | --no-port80]
# Installs Node (via the pinned .node-version), unpacks the release tarball,
# installs production deps, and enables seedypod-core.service on :3000. It also
# installs the restore helper (/usr/local/sbin/seedypod-restore, ADR-0021) and
# lets this user run it with sudo, for that one path, and the update helper
# (/usr/local/sbin/seedypod-update, ADR-0026) with its fixed arguments only, and
# podvision (/usr/local/bin/podvision, #191), core's native pod-state runner.
#   --restore <file|url>  then restore that backup bundle (seedypod-backup-….tar.gz)
#                         instead of choosing on the Welcome screen
#   --check               only say whether this machine can run core, and why not
#   --login-logo          only reinstall the SSH login logo from the unpacked prefix
#   --port80              only forward port 80 to core; the way to opt in off a Pi
#   --no-port80           only remove that forward, and keep it off on later installs
# The Rust HAL (hald) is installed separately by scripts/install-hal; on a new
# card, run it first so the restore brings hald's state back too.
# scripts/image/bake runs this while building the OS image, with no network for
# what the build already made: SEEDYPOD_TARBALL_URL and SEEDYPOD_RELEASE_URL point
# at them, and SEEDYPOD_CORE_USER is the account core runs as.
# Output is in colour on a terminal only; SEEDYPOD_COLOR=always or never overrides that.
set -euo pipefail
# The release can pin a pnpm newer than the one Corepack has, and Corepack would then
# stop to ask before fetching it, which hangs the image bake and the update helper.
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0

# ---- output --------------------------------------------------------------------
# Colour only on a terminal, which curl | bash still writes to. A log, tee or the OS
# image bake gets plain text, as do NO_COLOR and TERM=dumb. SEEDYPOD_COLOR=always or
# never overrides all of that, for tests. Each stream is decided on its own.
ui_colour() {
  case "${SEEDYPOD_COLOR:-}" in always) return 0 ;; never) return 1 ;; esac
  [ -t "$1" ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]
}
UI_OK="" UI_STEP="" UI_DIM="" UI_BOLD="" UI_OFF="" UI_WARN="" UI_ERR="" UI_EOFF=""
if ui_colour 1; then UI_OK=$'\e[32m' UI_STEP=$'\e[36m' UI_DIM=$'\e[2m' UI_BOLD=$'\e[1m' UI_OFF=$'\e[0m'; fi
if ui_colour 2; then UI_WARN=$'\e[33m' UI_ERR=$'\e[31m' UI_EOFF=$'\e[0m'; fi
step() { printf '%s→%s %s\n' "$UI_STEP" "$UI_OFF" "$*"; }
ok() { printf '%s✓%s %s\n' "$UI_OK" "$UI_OFF" "$*"; }
# The line a run ends on.
success() { printf '%s✓%s %s%s%s\n' "$UI_OK" "$UI_OFF" "$UI_BOLD" "$*" "$UI_OFF"; }
note() { printf '%s%s%s\n' "$UI_DIM" "$*" "$UI_OFF"; }
warn() { printf '%s%s%s\n' "$UI_WARN" "$*" "$UI_EOFF" >&2; }
error() { printf '%s%s%s\n' "$UI_ERR" "$*" "$UI_EOFF" >&2; }
fail() { printf '%s✗ %s%s\n' "$UI_ERR" "$*" "$UI_EOFF" >&2; }

# The SSH login screen's logo, with $1 beside it, or under it in a narrower window.
# Nothing at all off a terminal. One line where the blocks can't show: no colour, no
# UTF-8, or a window narrower than the logo.
banner() {
  [ -t 1 ] || [ "${SEEDYPOD_COLOR:-}" = always ] || return 0
  local cols i beside=1
  # Asked of the terminal itself: inside $( ) stdout is a pipe, and under curl | bash so is stdin.
  cols="$(stty size 2>/dev/null </dev/tty || true)"
  cols="${cols#* }"
  cols="${cols:-80}"
  case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) ;; *) cols=0 ;; esac
  if [ -z "$UI_OFF" ] || [ "$cols" -lt "$UI_LOGO_COLS" ]; then
    printf '%sseedypod %s%s\n\n' "$UI_BOLD" "$1" "$UI_OFF"
    return 0
  fi
  [ "$cols" -gt $((UI_LOGO_COL + ${#1})) ] || beside=0
  printf '\n'
  for i in "${!UI_LOGO[@]}"; do
    printf '%b' "${UI_LOGO[i]}"
    if [ "$beside" = 1 ] && [ "$i" -eq $((UI_LOGO_ROW + 1)) ]; then printf '\r\e[%dC%s%s%s' "$UI_LOGO_COL" "$UI_DIM" "$1" "$UI_OFF"; fi
    printf '\n'
  done
  [ "$beside" = 1 ] || printf '  %s%s%s\n' "$UI_DIM" "$1" "$UI_OFF"
  printf '\n'
}
# >>> logo: scripts/login-logo/generate.mjs writes this block (pnpm logo:generate)
UI_LOGO_COLS=54
UI_LOGO_COL=46
UI_LOGO_ROW=8
UI_LOGO=(
