# <<< logo

BRANCH="${SEEDYPOD_BRANCH:-__BRANCH__}"
PREFIX="${SEEDYPOD_PREFIX:-/opt/seedypod}"
REPO="${SEEDYPOD_REPO:-seedypod/core}"
# On the card, to outlast a reboot. Core writes it once per version, a minute after starting.
COMPILE_CACHE=/var/cache/seedypod/compile-cache
# ROOT prefixes /proc for tests (tests/scripts/install.board.test.ts).
ROOT="${SEEDYPOD_ROOT:-}"
RESTORE=""
CHECK=0
LOGIN_LOGO=0
PORT80=auto

while [ $# -gt 0 ]; do
  case "$1" in
    --branch) BRANCH="$2"; shift 2 ;;
    --prefix) PREFIX="$2"; shift 2 ;;
    --restore) RESTORE="$2"; shift 2 ;;
    --check) CHECK=1; shift ;;
    --login-logo) LOGIN_LOGO=1; shift ;;
    --port80) PORT80=on; shift ;;
    --no-port80) PORT80=off; shift ;;
    *) error "unknown arg: $1"; exit 2 ;;
  esac
done

# ---- better-sqlite3 on ARMv6 -------------------------------------------------
# Upstream's 32-bit ARM binary is built for ARMv7 and would crash on a Pi Zero W,
# and compiling there took 53 of a 56-minute install. So releases carry an ARMv6
# build (scripts/build-sqlite-armv6) under a versioned name. better-sqlite3's own
# install script runs prebuild-install, which takes it from a local directory.
# If it's missing, corrupt or won't load, the unit compiles as it always has.
# tests/scripts/install.sqlite.test.ts sources this file with SEEDYPOD_LIB_ONLY=1.
SQLITE_PREBUILT=""
sqlite_version() { sed -n 's/^  better-sqlite3@\([0-9][^:(]*\):$/\1/p' pnpm-lock.yaml | head -1; }
sqlite_binary() { echo "node_modules/.pnpm/better-sqlite3@$(sqlite_version)/node_modules/better-sqlite3/build/Release/better_sqlite3.node"; }
sqlite_works() { node -e "new (require('better-sqlite3'))(':memory:').exec('create table t (x)')" >/dev/null 2>&1; }
sqlite_compiler() { if command -v apt-get >/dev/null 2>&1; then sudo apt-get install -y -q build-essential python3 >/dev/null; fi; }

fetch_sqlite_prebuilt() {
  local version abi asset base dir="$TMP/sqlite"
  version="$(sqlite_version)"
  abi="$(node -p process.versions.modules)"
  asset="better-sqlite3-v$version-node-v$abi-linux-armv6.tar.gz"
  base="https://github.com/$REPO/releases/download/dev-latest"
  [ "$BRANCH" != main ] || base="https://github.com/$REPO/releases/latest/download"
  base="${SEEDYPOD_RELEASE_URL:-$base}"
  mkdir -p "$dir/prebuilds"
  if ! curl -fsSL --retry 3 "$base/$asset" -o "$dir/$asset" || ! curl -fsSL --retry 3 "$base/$asset.sha256" -o "$dir/$asset.sha256"; then
    warn "   no prebuilt $asset in this release"; return 1
  fi
  if ! (cd "$dir" && sha256sum -c --quiet "$asset.sha256") >/dev/null 2>&1; then
    warn "   the prebuilt $asset fails its sha256"; return 1
  fi
  if ! tar xzf "$dir/$asset" -C "$dir" build/Release/better_sqlite3.node || ! node -e 'require(process.argv[1])' "$dir/build/Release/better_sqlite3.node" >/dev/null 2>&1; then
    warn "   the prebuilt $asset doesn't load under Node $(node -v)"; return 1
  fi
  # prebuild-install looks it up by process.arch, which doesn't say ARMv6.
  mv -f "$dir/$asset" "$dir/prebuilds/better-sqlite3-v$version-node-v$abi-linux-arm.tar.gz"
  export npm_config_better_sqlite3_local_prebuilds="$dir/prebuilds"
  SQLITE_PREBUILT="$dir/build/Release/better_sqlite3.node"
}

prepare_sqlite() {
  # A rerun keeps what it built: pnpm leaves it, so don't fetch or compile anything.
  if [ ! -f "$(sqlite_binary)" ]; then
    if fetch_sqlite_prebuilt; then
      step "using the prebuilt ARMv6 better-sqlite3"
      return 0
    fi
    step "compiling better-sqlite3 here: allow about an hour"
    sqlite_compiler
  fi
  export npm_config_build_from_source=true
}

# prebuild-install that misses our file falls back to upstream's ARMv7 binary, which
# can load and crash later, so a prebuilt must also be the file that landed.
check_sqlite() {
  if sqlite_works && { [ -z "$SQLITE_PREBUILT" ] || cmp -s "$SQLITE_PREBUILT" "$(sqlite_binary)"; }; then return 0; fi
  step "better-sqlite3 didn't come out usable; compiling it here: allow about an hour"
  sqlite_compiler
  npm_config_build_from_source=true pnpm rebuild better-sqlite3
  sqlite_works || { fail "better-sqlite3 still doesn't load on this machine"; return 1; }
}

# A rerun with the same lockfile and Node has nothing to install, and pnpm takes 40 s
# on a Pi Zero to find that out. A failed install leaves no stamp, so it's tried again.
deps_stamp() { echo "node_modules/.seedypod-lock-$(node -v)"; }

# tar never deletes, and every build names its chunks anew, so on a small card they'd
# pile up. Run after the restart, because the old core loads chunks on first use. If
# the listing comes back empty, nothing is removed.
prune_dist() {
  local keep file
  keep="$(tar tzf "$1" 2>/dev/null | sed 's#^\./##' | grep '^server/dist/.')" || return 0
  find server/dist -type f | sort | comm -23 - <(printf '%s\n' "$keep" | sort) | while IFS= read -r file; do
    sudo rm -f "$file" || return 1
  done
}

install_deps() {
  if cmp -s pnpm-lock.yaml "$(deps_stamp)" && { [ "$NODE_FROM_SOURCE" != 1 ] || sqlite_works; }; then
    step "dependencies unchanged"
    return 0
  fi
  rm -f node_modules/.seedypod-lock-*
  if [ "$NODE_FROM_SOURCE" = 1 ]; then prepare_sqlite; fi
  pnpm install --prod --frozen-lockfile
  if [ "$NODE_FROM_SOURCE" = 1 ]; then check_sqlite; fi
  cp -f pnpm-lock.yaml "$(deps_stamp)"
}

# ---- which Node --------------------------------------------------------------
# Core runs on the Node in .node-version (24) where it ships: 64-bit ARM and x86.
# Node 24 has no 32-bit ARM build, so there core runs on Node 22, the last line
# that has one: the official ARMv7 build for a Zero 2 W, 3 or 4 on a 32-bit OS,
# and unofficial-builds.nodejs.org's ARMv6 build for the original Pi Zero W.
# Node 22 gets security fixes until April 2027; a Pi Zero 2 W on 64-bit
# Raspberry Pi OS gets back to 24 (docs/INSTALLATION.md#which-pi).
NODE_22=22.23.4
node_plan() {
  local model arch bits
  model="$(tr -d '\0' 2>/dev/null < "$ROOT/proc/device-tree/model" || true)"
  arch="$(uname -m)"
  bits="$(getconf LONG_BIT 2>/dev/null || echo 64)"
  NODE_FROM_SOURCE=0
  case "$arch:$bits" in
    aarch64:64|arm64:64) NODE_ARCH=arm64; NODE_VERSION=current ;;
    x86_64:64) NODE_ARCH=x64; NODE_VERSION=current ;;
    armv7l:*|aarch64:32|armv8l:*) NODE_ARCH=armv7l; NODE_VERSION=$NODE_22 ;;
    armv6l:*) NODE_ARCH=armv6l; NODE_VERSION=$NODE_22; NODE_FROM_SOURCE=1 ;;
    *)
      fail "This ${model:-$arch machine} can't run core: Node has no build for it."
      return 3 ;;
  esac
  if [ "$NODE_VERSION" = current ]; then
    ok "${model:-$arch} runs core on Node from .node-version"
  else
    ok "${model:-$arch} runs core on Node $NODE_VERSION ($NODE_ARCH): Node 24 has no 32-bit ARM build."
    note "  Node 22 gets security fixes until April 2027.${model:+ }$(case "$model" in *"Zero 2"*|*"Pi 3"*|*"Pi 4"*|*"Pi 5"*) echo "Reflash with 64-bit Raspberry Pi OS Lite to move to Node 24." ;; *) echo "A Pi Zero 2 W on 64-bit Raspberry Pi OS moves to Node 24." ;; esac)"
  fi
  [ "$NODE_FROM_SOURCE" = 1 ] && note "  better-sqlite3 comes prebuilt for ARMv6 from the release; without one it compiles here, which takes about an hour."
  return 0
}

# ---- port 80 -----------------------------------------------------------------
# So a browser reaches http://seedypod.local with no port, while core stays on 3000,
# which the iOS app, the hotspot address and saved addresses all assume. An nftables
# redirect, not a proxy: core exempts loopback from the API key (server/auth.ts), so
# behind systemd-socket-proxyd every LAN client would arrive as 127.0.0.1 and skip it.
# A redirect keeps the client's address, can't buffer SSE and runs no process, and
# Raspberry Pi OS Lite ships nftables. Its own table, because nothing else may touch
# it, and only for traffic addressed to this machine, so the hotspot's forwarding is
# left alone. IPv4 only, as core listens on IPv4. nft is in /usr/sbin, off this
# user's PATH. Only ever a nicety, so a failure here doesn't stop the install.
PORT80_RULES="$ROOT/usr/local/share/seedypod/port80.nft"
PORT80_OFF="$ROOT/usr/local/share/seedypod/port80.off"
PORT80_UNIT="$ROOT/etc/systemd/system/seedypod-port80.service"

# Writes stdin to $1 if that changes it, and sets FILE_CHANGED, because each daemon-reload
# reruns systemd's generators, which takes seconds on a Pi Zero. A write that fails
# returns non-zero, so it never reads as "unchanged".
put_file() {
  local text
  text="$(cat)"
  if [ -f "$1" ] && [ "$(cat "$1")" = "$text" ]; then return 0; fi
  printf '%s\n' "$text" | sudo tee "$1" >/dev/null || { error "couldn't write $1"; return 1; }
  FILE_CHANGED=1
}

port80_taken() { grep -Eqs '^ *[0-9]+: [0-9A-F]+:0050 [0-9A-F]+:[0-9A-F]+ 0A ' "$ROOT/proc/net/tcp" "$ROOT/proc/net/tcp6"; }

port80_remove() {
  [ -e "$PORT80_UNIT" ] || return 0
  sudo systemctl disable --now seedypod-port80.service >/dev/null 2>&1 || true
  sudo rm -f "$PORT80_UNIT" "$PORT80_RULES"
  sudo systemctl daemon-reload
}

install_port80() {
  case "$PORT80" in
    off)
      port80_remove
      sudo mkdir -p "$(dirname "$PORT80_OFF")" && sudo touch "$PORT80_OFF"
      step "port 80 left alone; core is on :3000"
      return 0 ;;
    on) sudo rm -f "$PORT80_OFF" ;;
    auto)
      [ ! -e "$PORT80_OFF" ] || return 0
      # A LAN box may well have plans for port 80. --port80 is how it says otherwise.
      if [ ! -e "$PORT80_RULES" ] && ! grep -aqs 'Raspberry Pi' "$ROOT/proc/device-tree/model"; then
        step "not a Raspberry Pi, so port 80 is left alone; scripts/install --port80 forwards it to core"
        return 0
      fi ;;
  esac
  if port80_taken; then
    port80_remove
    warn "   something else listens on port 80, so it's left alone; core is on :3000"
    return 0
  fi
  if [ ! -x "$ROOT/usr/sbin/nft" ] && command -v apt-get >/dev/null 2>&1; then
    sudo apt-get install -y -q nftables >/dev/null || true
  fi
  if [ ! -x "$ROOT/usr/sbin/nft" ]; then
    warn "   no nftables on this machine"
    return 1
  fi
  FILE_CHANGED=0
  sudo mkdir -p "$(dirname "$PORT80_RULES")"
  put_file "$PORT80_RULES" <<'RULES' || return 1
# Written by seedypod scripts/install: port 80 on this machine reaches core on 3000.
table ip seedypod
delete table ip seedypod
table ip seedypod {
  chain port80 {
    type nat hook prerouting priority dstnat; policy accept;
    fib daddr type local tcp dport 80 redirect to :3000
  }
}
RULES
  put_file "$PORT80_UNIT" <<'UNIT' || return 1
[Unit]
Description=seedypod: forward port 80 to core on 3000
After=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /usr/local/share/seedypod/port80.nft
ExecStop=/usr/sbin/nft delete table ip seedypod

[Install]
WantedBy=multi-user.target
UNIT
  # Asks nft, not systemd: a oneshot stays active after nftables.service flushes the ruleset.
  if [ "$FILE_CHANGED" -eq 0 ] && sudo "$ROOT/usr/sbin/nft" list table ip seedypod >/dev/null 2>&1; then
    step "port 80 already forwards to core"
    return 0
  fi
  if sudo systemctl daemon-reload && sudo systemctl enable seedypod-port80.service >/dev/null 2>&1 \
    && sudo systemctl restart seedypod-port80.service; then
    step "port 80 forwards to core"
    return 0
  fi
  port80_remove
  return 1
}

# ---- login logo --------------------------------------------------------------
# The animation an SSH login opens with. It lives in /etc/profile.d: pam_motd runs
# update-motd.d with no terminal and prints what it collected, so nothing there
# can animate, see the window size or take a keypress. Root-owned and outside
# $PREFIX (which this user owns) like the restore helper, since every login runs
# it, root's included. Only ever a nicety, so a failure here doesn't stop the install.
install_login_logo() {
  local from="$PREFIX/scripts/login-logo" share="$ROOT/usr/local/share/seedypod" profile="$ROOT/etc/profile.d/seedypod-logo.sh"
  local branch commit
  branch="$(sed -n 's/.*"branch": *"\([^"]*\)".*/\1/p' "$PREFIX/.git-info" 2>/dev/null || true)"
  commit="$(sed -n 's/.*"commitHash": *"\([^"]*\)".*/\1/p' "$PREFIX/.git-info" 2>/dev/null || true)"
  sudo mkdir -p "$share" "$(dirname "$profile")" \
    && sudo cp -f "$from/login-logo" "$from/login-stats" "$from/logo.frames" "$share/" \
    && sudo cp -f "$from/profile.sh" "$profile" \
    && echo "${branch:-dev}${commit:+@$commit}" | sudo tee "$share/version" >/dev/null \
    && sudo chown root:root "$share" "$share/login-logo" "$share/login-stats" "$share/logo.frames" "$share/version" "$profile" \
    && sudo chmod 0755 "$share/login-logo" "$share/login-stats" \
    && sudo chmod 0644 "$share/logo.frames" "$share/version" "$profile"
}

# ---- who runs core -----------------------------------------------------------
# The login that installs it, unless this machine already runs core as another
# account. The OS image does: its login doesn't exist until first boot, so core has
# seedypod-core there, and an update run from the login has to keep that.
CORE_UNIT="$ROOT/etc/systemd/system/seedypod-core.service"
HALD_UNIT="$ROOT/etc/systemd/system/hald.service"
core_user() {
  local user="${SEEDYPOD_CORE_USER:-}"
  [ -n "$user" ] || user="$(sed -n 's/^User=//p' "$CORE_UNIT" 2>/dev/null | head -1 || true)"
  echo "${user:-$USER}"
}
# The group that reads hald's files, which install-hal names after hald's account.
hal_group() {
  local group
  group="$(sed -n 's/^Group=//p' "$HALD_UNIT" 2>/dev/null | head -1 || true)"
  echo "${group:-seedypod}"
}

# Core addresses hald by its unit id (the Pi's serial).
hal_unit_id() {
  hald --config /etc/seedypod/hal.toml --check 2>/dev/null | sed -n 's/.*"unit_id": *"\([^"]*\)".*/\1/p' | head -1 || true
}

# Only the account that owns $PREFIX can unpack over it, so when that's not this
# login, core stops, the login borrows it, and finish_prefix hands it back. pnpm's
# store sits inside, so both accounts find the one that node_modules was linked
# from: on another, pnpm would rebuild node_modules and with it better-sqlite3.
claim_prefix() {
  sudo mkdir -p "$PREFIX"
  if [ "$CORE_USER" = "$USER" ]; then sudo chown "$USER" "$PREFIX"; return 0; fi
  sudo systemctl stop seedypod-core.service 2>/dev/null || true
  own_prefix "$USER"
  export npm_config_store_dir="$PREFIX/.pnpm-store"
}
finish_prefix() {
  if [ "$CORE_USER" != "$USER" ]; then own_prefix "$CORE_USER"; fi
  # Restore may run before core's first start creates data/. Create it as core
  # now, so the root restore helper never becomes its owner.
  if [ ! -d "$PREFIX/data" ]; then
    sudo -u "$CORE_USER" mkdir -p "$PREFIX/data"
  fi
}
# Never data/: the tarball has none, and if this run dies with no sudo left to hand things
# back, as in a power cut, core can still read its code and write its database.
own_prefix() {
  sudo chown "$1" "$PREFIX"
  sudo find "$PREFIX" -mindepth 1 -maxdepth 1 ! -name data -exec chown -R "$1" {} +
}
# ---- update helper -------------------------------------------------------------
# Settings → Update runs it (ADR-0026). Root-owned with this prefix written in, like
# the restore helper, and the sudoers rule lists each command core may run, so sudo
# itself refuses any other argument; the helper checks them again.
# tests/scripts/install.update.test.ts sources this file with SEEDYPOD_LIB_ONLY=1.
UPDATE_HELPER=/usr/local/sbin/seedypod-update
update_sudoers() {
  local args
  for args in --status --check --start '--channel stable' '--channel dev'; do
    echo "$1 ALL=(root) NOPASSWD: $UPDATE_HELPER $args"
  done
}
install_update_helper() {
  local helper="$ROOT$UPDATE_HELPER" rules="$ROOT/etc/sudoers.d/seedypod-update" tmp
  sudo mkdir -p "$(dirname "$helper")" "$(dirname "$rules")" || return 1
  { sed "s#__PREFIX__#$PREFIX#" "$PREFIX/scripts/seedypod-update.cjs" | sudo tee "$helper" >/dev/null; } \
    && sudo chown root:root "$helper" && sudo chmod 0755 "$helper" || return 1
  tmp="$(mktemp)"
  update_sudoers "$CORE_USER" > "$tmp"
  if ! sudo visudo -cf "$tmp" >/dev/null; then
    rm -f "$tmp"
    return 1
  fi
  sudo install -m 0440 -o root -g root "$tmp" "$rules"
  local ok=$?
  rm -f "$tmp"
  return $ok
}

# ---- podvision -------------------------------------------------------------------
# Core's native pod-state runner (#191), a release binary like hald that core runs
# at nice 19 for each capture. Without it, or with one that won't run here, core
# scores pods in TypeScript as before, so a failure here only warns.
# tests/scripts/install.podvision.test.ts sources this file with SEEDYPOD_LIB_ONLY=1.
PODVISION=/usr/local/bin/podvision
podvision_target() {
  case "$(uname -m):$(getconf LONG_BIT 2>/dev/null || echo 64)" in
    aarch64:64|arm64:64) echo aarch64-unknown-linux-gnu ;;
    aarch64:32|armv6l:*|armv7l:*|armv8l:*) echo arm-unknown-linux-gnueabihf ;;
    *) return 1 ;;
  esac
}
install_podvision() {
  local target asset base dir="$TMP/podvision" dest="$ROOT$PODVISION"
  if ! target="$(podvision_target)"; then
    note "   no podvision build for $(uname -m): pod-state runs in TypeScript"
    return 0
  fi
  asset="podvision-$target"
  base="https://github.com/$REPO/releases/download/dev-latest"
  [ "$BRANCH" != main ] || base="https://github.com/$REPO/releases/latest/download"
  base="${SEEDYPOD_RELEASE_URL:-$base}"
  mkdir -p "$dir"
  if ! curl -fsSL --retry 3 "$base/$asset" -o "$dir/$asset" || ! curl -fsSL --retry 3 "$base/$asset.sha256" -o "$dir/$asset.sha256"; then
    warn "   no $asset in this release"; return 1
  fi
  if ! (cd "$dir" && sha256sum -c --quiet "$asset.sha256") >/dev/null 2>&1; then
    warn "   $asset fails its sha256"; return 1
  fi
  chmod 0755 "$dir/$asset"
  if ! "$dir/$asset" --version >/dev/null 2>&1; then
    warn "   $asset doesn't run on this machine"; return 1
  fi
  cmp -s "$dir/$asset" "$dest" && return 0
  if ! { sudo mkdir -p "$(dirname "$dest")" && sudo install -m 0755 "$dir/$asset" "$dest"; }; then
    warn "   couldn't copy $asset to $dest"; return 1
  fi
  step "installed $("$dest" --version) for pod-state"
}

# An update that dies halfway must not leave core stopped, or unable to write its database.
# hald --usb-recover won't reboot for the USB hub while a file is in here. It's in
# /run, so if this dies mid-way a reboot clears it. Never worth failing an install for.
BUSY_DIR="${SEEDYPOD_ROOT:-}/run/seedypod-busy"
mark_busy() { { sudo mkdir -p "$BUSY_DIR" && sudo touch "$BUSY_DIR/install"; } 2>/dev/null || true; }
clear_busy() { sudo rm -f "$BUSY_DIR/install" 2>/dev/null || true; }
abandon_update() {
  finish_prefix || true
  if [ "$CORE_USER" != "$USER" ]; then sudo systemctl start seedypod-core.service 2>/dev/null || true; fi
}
if [ "${SEEDYPOD_LIB_ONLY:-}" = 1 ]; then return 0; fi
if [ "$LOGIN_LOGO" = 1 ]; then install_login_logo; exit $?; fi
if [ "$PORT80" != auto ]; then install_port80; exit $?; fi
if [ "$CHECK" = 1 ]; then node_plan; exit $?; fi
[ "$BRANCH" = "__BRANCH__" ] && BRANCH=main
banner "core installer · branch $BRANCH"
node_plan || exit 3
# The installer cd's into $PREFIX, so a local bundle needs its full path.
case "$RESTORE" in
  ""|http://*|https://*) ;;
  *)
    [ -f "$RESTORE" ] || { error "no such backup: $RESTORE"; exit 2; }
    RESTORE="$(cd "$(dirname "$RESTORE")" && pwd)/$(basename "$RESTORE")" ;;
esac

if [ -n "${SEEDYPOD_TARBALL_URL:-}" ]; then
  TARBALL_URL="$SEEDYPOD_TARBALL_URL"
elif [ "$BRANCH" = "main" ]; then
  TARBALL_URL="https://github.com/$REPO/releases/latest/download/seedypod-core.tar.gz"
elif [ "$BRANCH" = "dev" ]; then
  TARBALL_URL="https://github.com/$REPO/releases/download/dev-latest/seedypod-core.tar.gz"
else
  TARBALL_URL="https://nightly.link/$REPO/workflows/build/$BRANCH/seedypod-core.zip"
fi

step "seedypod core: branch=$BRANCH prefix=$PREFIX"
CORE_USER="$(core_user)"
TMP=$(mktemp -d)
mark_busy
trap clear_busy EXIT
curl -fsSL "$TARBALL_URL" -o "$TMP/pkg"
trap 'abandon_update; clear_busy' EXIT
claim_prefix
if file "$TMP/pkg" | grep -q Zip; then (cd "$TMP" && unzip -q pkg && tar xzf seedypod-core.tar.gz -C "$PREFIX"); else tar xzf "$TMP/pkg" -C "$PREFIX"; fi
TARBALL="$TMP/pkg"
[ ! -f "$TMP/seedypod-core.tar.gz" ] || TARBALL="$TMP/seedypod-core.tar.gz"

cd "$PREFIX"
NODE_WANT=$NODE_VERSION
[ "$NODE_WANT" = current ] && NODE_WANT=$(cat .node-version)
# ARMv6 builds live on unofficial-builds.nodejs.org; everything else on nodejs.org.
NODE_DIST=https://nodejs.org/dist
[ "$NODE_ARCH" = armv6l ] && NODE_DIST=https://unofficial-builds.nodejs.org/download/release
if ! command -v node >/dev/null || [ "$(node -v)" != "v$NODE_WANT" ]; then
  step "installing Node $NODE_WANT ($NODE_ARCH)"
  curl -fsSL "$NODE_DIST/v$NODE_WANT/node-v$NODE_WANT-linux-$NODE_ARCH.tar.xz" | sudo tar -xJ -C /usr/local --strip-components=1
fi
corepack enable >/dev/null 2>&1 || true
install_deps
finish_prefix
# Keyed on content, so a stale entry is only dead weight, but each update would leave a set of them.
sudo rm -rf "$COMPILE_CACHE"

# Wi-Fi setup (button held 10 s) drives NetworkManager through nmcli. A system
# service has no desktop session, so polkit would refuse it; allow this user only.
if command -v nmcli >/dev/null 2>&1 && [ -d /etc/polkit-1/rules.d ]; then
  sudo tee /etc/polkit-1/rules.d/50-seedypod-network.rules >/dev/null <<RULES
// seedypod core may manage Wi-Fi (setup hotspot, joining a network). Written by scripts/install.
polkit.addRule(function (action, subject) {
  if (action.id.indexOf("org.freedesktop.NetworkManager.") === 0 && subject.user === "$CORE_USER") return polkit.Result.YES;
});
RULES
fi

# Core addresses hald by its unit id (the Pi's serial). With hald on this Pi, ask
# it; otherwise core runs on the simulator until HAL_MQTT_URL and HAL_UNIT_ID are
# set in the unit for a hald elsewhere.
HAL_UNIT_ID="${SEEDYPOD_HAL_UNIT_ID:-}"
if [ -z "$HAL_UNIT_ID" ] && command -v hald >/dev/null 2>&1; then
  HAL_UNIT_ID="$(hal_unit_id)"
fi
if [ -n "$HAL_UNIT_ID" ]; then
  HAL_ENV="Environment=HAL_MQTT_URL=mqtt://127.0.0.1:1883 HAL_UNIT_ID=$HAL_UNIT_ID"
  step "talking to hald $HAL_UNIT_ID on this machine"
else
  HAL_ENV="# Environment=HAL_MQTT_URL=mqtt://<unit>:1883 HAL_UNIT_ID=<from hald --check> HAL_HTTP_URL=http://<unit>:3001"
  warn "   no hald on this machine: core starts on the simulator. To drive a unit, set HAL_MQTT_URL and HAL_UNIT_ID"
  warn "   in /etc/systemd/system/seedypod-core.service (see docs/INSTALLATION.md#which-pi)."
fi

FILE_CHANGED=0
put_file /etc/systemd/system/seedypod-core.service <<UNIT
[Unit]
Description=seedypod core (tRPC/MCP/web)
# Not network-online.target: schedules run the pump and lights, with or without Wi-Fi.
After=hald.service mosquitto.service

[Service]
WorkingDirectory=$PREFIX
Environment=NODE_ENV=production PORT=3000 NODE_COMPILE_CACHE=$COMPILE_CACHE
CacheDirectory=seedypod
$HAL_ENV
ExecStart=/usr/local/bin/node server/dist/index.js
Restart=always
RestartSec=3
User=$CORE_USER

[Install]
WantedBy=multi-user.target
UNIT
# Restore helper (ADR-0021): root-owned, with this prefix written in, so it never
# loads anything from $PREFIX (which this user owns). Core runs it through sudo.
HELPER=/usr/local/sbin/seedypod-restore
sed "s#__PREFIX__#$PREFIX#" "$PREFIX/scripts/seedypod-restore.cjs" | sudo tee "$HELPER" >/dev/null
sudo chown root:root "$HELPER"
sudo chmod 0755 "$HELPER"
SUDOERS_TMP=$(mktemp)
echo "$CORE_USER ALL=(root) NOPASSWD: $HELPER" > "$SUDOERS_TMP"
if sudo visudo -cf "$SUDOERS_TMP" >/dev/null; then
  sudo install -m 0440 -o root -g root "$SUDOERS_TMP" /etc/sudoers.d/seedypod-restore
else
  warn "   couldn't validate the sudoers rule for $HELPER; restore from the web UI is off"
fi
rm -f "$SUDOERS_TMP"
install_update_helper || warn "   couldn't install the update helper; update from the web UI is off"
install_podvision || warn "   couldn't install podvision; pod-state runs in TypeScript"

# Backups read hal.toml, hald's state and the broker password through the seedypod
# group that install-hal creates (ADR-0021); install-hal adds us too if it runs later.
HAL_GROUP="$(hal_group)"
if getent group "$HAL_GROUP" >/dev/null 2>&1; then sudo usermod -aG "$HAL_GROUP" "$CORE_USER"; fi

install_login_logo || warn "   couldn't install the login logo; logins work as before"

# NeedDaemonReload catches a unit an interrupted run wrote and never loaded.
if [ "$FILE_CHANGED" = 1 ] || [ "$(systemctl show -p NeedDaemonReload --value seedypod-core.service 2>/dev/null)" = yes ]; then
  sudo systemctl daemon-reload
fi
systemctl is-enabled --quiet seedypod-core.service || sudo systemctl enable seedypod-core.service >/dev/null
sudo systemctl restart seedypod-core.service
trap - EXIT
trap clear_busy EXIT
prune_dist "$TARBALL" || warn "   couldn't clear old chunks"
install_port80 || warn "   couldn't forward port 80; core is on :3000"
if [ -n "$RESTORE" ]; then
  BUNDLE="$RESTORE"
  case "$RESTORE" in
    http://*|https://*)
      BUNDLE="$TMP/restore.tar.gz"
      step "downloading $RESTORE"
      curl -fsSL "$RESTORE" -o "$BUNDLE" ;;
  esac
  step "restoring $RESTORE"
  sudo "$HELPER" "$BUNDLE" >/dev/null
fi
ADDRESS="http://$(hostname -I | awk '{print $1}')"
[ -e "$PORT80_RULES" ] || ADDRESS="$ADDRESS:3000"
success "seedypod core running on $ADDRESS"
