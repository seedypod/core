#!/usr/bin/env bash
# leafypod core installer for a Raspberry Pi running Raspberry Pi OS (64-bit).
# Usage: curl -fsSL https://raw.githubusercontent.com/ng/leafypod/main/scripts/install | bash
#        scripts/install [--branch dev] [--prefix /opt/leafypod]
# Installs Node (via the pinned .node-version), unpacks the release tarball,
# installs production deps, and enables leafypod-core.service on :3000.
# The Rust HAL (hald) is installed separately by scripts/install-hal.
set -euo pipefail

BRANCH="${LEAFYPOD_BRANCH:-__BRANCH__}"
PREFIX="${LEAFYPOD_PREFIX:-/opt/leafypod}"
REPO="${LEAFYPOD_REPO:-ng/leafypod}"

while [ $# -gt 0 ]; do
  case "$1" in
    --branch) BRANCH="$2"; shift 2 ;;
    --prefix) PREFIX="$2"; shift 2 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done
[ "$BRANCH" = "__BRANCH__" ] && BRANCH=main

if [ "$BRANCH" = "main" ]; then
  TARBALL_URL="https://github.com/$REPO/releases/latest/download/leafypod-core.tar.gz"
elif [ "$BRANCH" = "dev" ]; then
  TARBALL_URL="https://github.com/$REPO/releases/download/dev-latest/leafypod-core.tar.gz"
else
  TARBALL_URL="https://nightly.link/$REPO/workflows/build/$BRANCH/leafypod-core.zip"
fi

echo "→ leafypod core: branch=$BRANCH prefix=$PREFIX"
sudo mkdir -p "$PREFIX" && sudo chown "$USER" "$PREFIX"
TMP=$(mktemp -d)
curl -fsSL "$TARBALL_URL" -o "$TMP/pkg"
if file "$TMP/pkg" | grep -q Zip; then (cd "$TMP" && unzip -q pkg && tar xzf leafypod-core.tar.gz -C "$PREFIX"); else tar xzf "$TMP/pkg" -C "$PREFIX"; fi

cd "$PREFIX"
NODE_WANT=$(cat .node-version)
if ! command -v node >/dev/null || [ "$(node -v)" != "v$NODE_WANT" ]; then
  echo "→ installing Node $NODE_WANT"
  curl -fsSL "https://nodejs.org/dist/v$NODE_WANT/node-v$NODE_WANT-linux-$(uname -m | sed 's/aarch64/arm64/;s/armv7l/armv7l/').tar.xz" | sudo tar -xJ -C /usr/local --strip-components=1
fi
corepack enable >/dev/null 2>&1 || true
pnpm install --prod --frozen-lockfile

sudo tee /etc/systemd/system/leafypod-core.service >/dev/null <<UNIT
[Unit]
Description=leafypod core (tRPC/MCP/web)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=$PREFIX
Environment=NODE_ENV=production PORT=3000
Environment=HAL_MQTT_URL=mqtt://127.0.0.1:1883
ExecStart=/usr/local/bin/node server/dist/index.js
Restart=always
RestartSec=3
User=$USER

[Install]
WantedBy=multi-user.target
UNIT
sudo systemctl daemon-reload
sudo systemctl enable --now leafypod-core.service
echo "✓ leafypod core running on http://$(hostname -I | awk '{print $1}'):3000"
